<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShadOBS</RootNamespace>
    <AssemblyName>ShadOBS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <Product>ShadOBS</Product>
    <Description>Sets up OBS as an always-on clip recorder</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="assets\shadobs.lua" LogicalName="shadobs.lua" />
    <EmbeddedResource Include="assets\saved.wav" LogicalName="saved.wav" />
  </ItemGroup>

</Project>
